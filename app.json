{
  "expo": {
    "name": "Agri Soft Pro",
    "slug": "agrisoft-pro",
    "owner": "syedsaadaliaskari",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/brand-logo.png",
    "scheme": "agrisoftpro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.agrisoft.pro.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#f3f5f8",
        "foregroundImage": "./assets/images/brand-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#f3f5f8"
        }
      ],
      "expo-sharing",
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f6b83b3-e51c-44c2-9f55-2ea37662c32f"
      }
    }
  }
}
